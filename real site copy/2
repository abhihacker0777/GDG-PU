[data-theme="dark"] footer.page-footer .footer-bottom .site-info:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] footer.page-footer .footer-bottom .site-info .footer-copyright:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
