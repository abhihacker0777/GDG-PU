}

/* Django-ONLY layout fix (no /next counterpart). The bell popover mounts INSIDE the
   navbar (`li.notifications-menu-item`), so legacy navbar/heading descendant CSS
   cascades into the BDS NotificationsMenu and breaks its header: the title (a BDS
   <h4>) drops below the "mark all as read" action and a large empty band opens at the
   top of the panel â€” the misaligned/oversized header seen only on the Django island
   (/next renders the same component with no legacy CSS around it). Re-assert the BDS
   header's intended flex row and collapse the inherited heading spacing so it packs
   like /next. Mode-agnostic â€” the layout bug exists in both light and dark. */
[class*="NotificationsMenu-styles__header_"] {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 16px !important;
}
[class*="NotificationsMenu-styles__header_"] h1,
[class*="NotificationsMenu-styles__header_"] h2,
[class*="NotificationsMenu-styles__header_"] h3,
[class*="NotificationsMenu-styles__header_"] h4,
[class*="NotificationsMenu-styles__header_"] h5,
[class*="NotificationsMenu-styles__header_"] h6 {
  margin: 0 !important;
  line-height: 1.2 !important;
}
/* Both header children (title + the mark-all/gear group) on one centered row. */
[class*="NotificationsMenu-styles__header_"] > * {
  align-self: center !important;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

/* Match /next's panel width: /next passes style width min(380px, 92vw); the Django
   island passes no width so BDS falls back to its 330px default, making the panel
   visibly narrower. Mode-agnostic. */
[class*="NotificationsMenu-styles__menu"] {
  width: min(380px, 92vw) !important;
}

/* "View all notifications" footer link: BDS renders it as <Text color="primary">,
   which resolves --text-color-primary â€” a var the Django dark block never sets, so
   it fell back to white instead of the brand colour /next shows. Point it at the
   brand primary token (defined in both modes). */
/* Must out-specify the navbar's blanket dark rule
   `[data-theme="dark"] header.navs [class*="Text"]` (0,3,1, !important) that paints
   every header control white â€” so scope under header.navs AND match the Text node. */
[data-theme="dark"] header.navs [data-testid="notifications-view-all"]:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] header.navs [data-testid="notifications-view-all"] *:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] header.navs [data-testid="notifications-view-all"] [class*="Text"]:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: #4285F4 !important;
}

/* Bell trigger backdrop (DIS-3585). The trigger paints a --ColorSoftLight circle
   behind the bell on hover/open. On /next's header that elevation reads invisible in
   dark; on the legacy navbar it shows as a light halo /next doesn't have. Zero it in
   dark (light mode keeps the affordance). The class is added in NotificationsDropdown.js;
   the !important beats the element's inline background. */
[data-theme="dark"] .notifications-bell-backdrop:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: transparent !important;
}

/* Dark-mode toggle in the user menu (pages/menus/dark-mode-toggle.html). A visual
   twin of the Next.js header's ThemeToggle (label + Sun Â· switch Â· Moon) so the two
   headers match. Replicates ThemeToggle.module.scss with the --theme-palette-* tokens
   (1:1 with the Next version's --Color* tokens) and drives state from <html data-theme>
   instead of React. Not theme-scoped â€” it's a real control that renders in both modes;
   the [data-theme="dark"] rules below flip its active state. */
.top-nav-dragon .main-menu.dropdown-menu > li.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 8px;
  /* Matches `.new-dropdown-menu li > a { border-radius: 6px }` so the hover background
     this row now receives (see the GENERAL_HEADER_DROPDOWN_LINK_HOVER_* blocks in
     generalstyles.css) paints the same rounded shape as every sibling row's, instead of a
     square band. Padding above already matches the anchors' 12px 8px. */
  border-radius: 6px;
  color: var(--theme-palette-soft-dark);
  font-size: 14px;
  font-weight: 400;
  line-height: 136%;
  /* The whole row toggles the theme (SGP-32161 #8) â€” the controller in base.html no
     longer gates on the click landing inside .theme-toggle__switch. Without this the row
     is clickable but still shows a text cursor over the label, so the larger hit target
     is undiscoverable. */
  cursor: pointer;
}

.theme-toggle__label {
  flex: 1;
}
.theme-toggle__label--dark {
  display: none;
}
[data-theme="dark"] .theme-toggle__label--light:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  display: none;
}
[data-theme="dark"] .theme-toggle__label--dark:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  display: block;
}

.theme-toggle__control {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8px;
}

.theme-toggle__icon {
  width: 16px;
  height: 16px;
  color: var(--theme-palette-soft-dark);
  opacity: 0.4;
  transition: opacity 120ms linear, color 120ms linear;
}
/* Sun is the active icon in light, Moon in dark. */
.theme-toggle__icon--sun {
  color: var(--theme-palette-primary);
  opacity: 1;
}
[data-theme="dark"] .theme-toggle__icon--sun:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-soft-dark);
  opacity: 0.4;
}
/* SGP-32161 #8 (2nd QA round): the whole control collapsed onto one colour in dark, by two
   separate routes. The pill fill, the pill border and the active moon all painted with
   --theme-palette-primary. On LEGACY pages that token is dead â€” generalstyles.css
   re-declares it after theme.css at equal specificity, so it keeps the LIGHT brand value
   (#2E203C on demo/Etsy), which is precisely the dark dropdown surface. Measured: the
   pill fill, the pill border, the knob AND the active moon all resolved to rgb(46,32,60)
   on a rgb(46,32,60) menu â€” 1.00:1 four times over, i.e. the whole control vanished and
   only the 40%-opacity sun remained. (Same root cause as items 6 and 7; in next/
   --ColorPrimary DOES flip, via *_DARK_COLOR_OVERRIDES, which is why the Next toggle
   looks correct and this one did not.)
   Re-pointed at the tokens that actually role-swap on legacy. */
[data-theme="dark"] .theme-toggle__icon--moon:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-soft-dark);
  opacity: 1;
}

.theme-toggle__switch {
  position: relative;
  width: 38px;
  height: 22px;
  padding: 0;
  border: 1px solid var(--theme-palette-light-borders);
  border-radius: 999px;
  background-color: var(--theme-palette-soft-light);
  cursor: pointer;
  transition: background-color 160ms ease, border-color 160ms ease;
}
/* Near-white filled track with the knob punched out of it â€” the appearance Etsy production
   ships on its Next pages. Fill and border carry the same value so the pill reads as one
   solid shape rather than an outlined one. --theme-palette-soft-dark is the legacy twin of
   the --ColorSoftDark the Next module now uses, so both apps land on the same rendering
   regardless of how a tenant configured its dark brand colour. */
[data-theme="dark"] .theme-toggle__switch:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  border-color: var(--theme-palette-soft-dark);
  background-color: var(--theme-palette-soft-dark);
}
.theme-toggle__switch:focus-visible {
  outline: 2px solid var(--theme-palette-primary);
  outline-offset: 2px;
}
/* --theme-palette-primary is the dark surface itself on legacy, so the light-mode focus
   ring above is invisible in dark â€” the keyboard affordance disappeared exactly where the
   control did. */
[data-theme="dark"] .theme-toggle__switch:focus-visible:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  outline-color: var(--theme-palette-dark);
}

.theme-toggle__knob {
  position: absolute;
  top: 50%;
  left: 2px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background-color: var(--theme-palette-light);
  box-shadow: 0 1px 2px rgb(0 0 0 / 25%);
  transform: translateY(-50%);
  transition: transform 160ms ease;
}
/* No background-color override: the base rule's --theme-palette-light flips to #2E203C in
   dark, which is exactly the value Next's knob renders (--ColorLight, also #2E203C). The
   knob is deliberately DARKER than the pill in both apps â€” it reads as a cutout, not a
   highlight. It only vanished before because the pill was painted #2E203C too. */
[data-theme="dark"] .theme-toggle__knob:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  transform: translate(16px, -50%);
}

/* --- DIS-3613 logged-out icon-only toggle (top bar) ---
   Reuses the .theme-toggle / .theme-toggle__switch hooks (so the base.html controller
   wires the click) but drops the dropdown pill/knob/label styling. Two grid-stacked
   icons reflect the current theme (sun in light, moon in dark); the visible one is
   chosen by opacity/transform on [data-theme], animating on toggle (BDS 2.0
   bds-theme-toggle style â€” legacy has no next-themes suppression, so a transition is
   reliable here). Desktop matches the navbar link vertical rhythm; mobile centers
   within the header actions row. */
.theme-toggle--compact {
  display: inline-flex;
  align-items: center;
  padding: 0;
  margin: 0;
}
.theme-toggle--compact .theme-toggle__switch {
  display: inline-grid;
  place-items: center;
  /* Reset the fixed 38x22 pill size the base .theme-toggle__switch sets (that pill
     height is why the mobile icon overflowed and sat below the row); size to the icon
     instead. Desktop re-stretches height to 100% of the row below. */
  width: auto;
  height: auto;
  padding: 8px;
  border: none;
  border-radius: 9999px;
  background: none;
  color: inherit;
  cursor: pointer;
}
.theme-toggle--compact .theme-toggle__icon {
  grid-area: 1 / 1;
  width: 20px;
  height: 20px;
  color: inherit;
  transition-property: opacity, transform;
  transition-duration: 0.2s;
  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
}
/* Light theme: sun in, moon rotated out. */
.theme-toggle--compact .theme-toggle__icon--sun {
  opacity: 1;
  transform: rotate(0) scale(1);
}
.theme-toggle--compact .theme-toggle__icon--moon {
  opacity: 0;
  transform: rotate(90deg) scale(0.4);
}
/* Dark theme: sun rotated out, moon in. */
[data-theme="dark"] .theme-toggle--compact .theme-toggle__icon--sun:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  opacity: 0;
  transform: rotate(-90deg) scale(0.4);
}
[data-theme="dark"] .theme-toggle--compact .theme-toggle__icon--moon:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  opacity: 1;
  transform: rotate(0) scale(1);
}
/* Desktop: the nav row (.top-nav-dragon) stretches every item to the full row height.
   A navbar rule keeps the <li> as a block and floats the button to the top, so instead
   of fighting it we make the button fill the li's full height; its own grid then
   centers the icon on the sibling nav links' vertical center. Scoped to the desktop li
   (:not(.mobile-header-action)) so the mobile toggle is unaffected. */
.top-nav-dragon .theme-toggle--compact:not(.mobile-header-action) .theme-toggle__switch {
  height: 100%;
}
/* Mobile: the .mobile-header-actions flex row already centers its items, so the mobile
   toggle needs nothing extra here. */
@media (prefers-reduced-motion: reduce) {
  .theme-toggle--compact .theme-toggle__icon {
    transition: none;
  }
}

/* --- DIS-3555 legacy dark-mode residuals (Account settings + Profile / Edit profile) ---
   These surfaces use compiled-LESS hex (@gray-lighter/@beige/#333), Bootstrap defaults or
   third-party (react-widgets, Material) chrome â€” none read the palette tokens, so they stay
   light in dark mode. Re-point them to the role-swapping --theme-palette-* tokens. */

/* Profile tabs (P1): .nav-underscore resting color (@gray-lighter) + active color don't flip.
   The active underline keeps @brand-primary (brand color, intentionally unchanged). */
[data-theme="dark"] .nav-underscore li a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-soft-dark);
}
[data-theme="dark"] .nav-underscore li.active a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .no-touch .nav-underscore li a:hover:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .nav-underscore li a.active:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-dark);
}

/* Profile â†’ Updates "Global" checkbox is an MUI (v4) Checkbox whose unchecked SVG
   box uses rgba(0,0,0,.54) (black) â€” invisible on dark. Lighten the unchecked box to
   a visible token; the checked state keeps MUI's primary (brand) fill. */
[data-theme="dark"] .MuiCheckbox-root:not(.Mui-checked):where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .MuiCheckbox-root:not(.Mui-checked) .MuiSvgIcon-root:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-soft-dark) !important;
}

/* Profile â†’ My tickets (DIS-3555 P6). Ticket cards use hardcoded text colors that
   don't flip: `.event-title a { color:#333 }` (profile.less) and the surrounding
   card copy. The `.style-editor-card` surface is a Bootstrap `.panel-default`, so it
   already flips via the panel rule above; here we only re-point the static text. */
[data-theme="dark"] .style-editor-card:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .style-editor-card .event-title:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .style-editor-card .event-title a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .event-title:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .event-title a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  /* !important: profile.less nests `.event-title a { color:#333 }` under a deep
     context that out-specifies a plain override, so force the flip. */
  color: var(--theme-palette-dark) !important;
}

/* Tag chips â€” react-widgets multiselect (Account tags A1a, Edit-profile interests E2):
   hardcoded #f4f4f4 chip bg, light widget container.
   This rule only lands the `color` half: MultiselectInput.less compiles to a (0,5,1)
   selector that beats this (0,2,1) on `background-color`, so the chip background is
   flipped at source in that module instead (DIS-3621). The remove button needs no rule
   â€” react-widgets sets `color: inherit` on `.rw-multiselect-tag-btn`, so it follows the
   `color` below. */
[data-theme="dark"] .rw-multiselect-taglist > li:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-soft-light);
  color: var(--theme-palette-dark);
}
[data-theme="dark"] .rw-widget-container:not(.BDS-component):where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-light);
  border-color: var(--theme-palette-light-borders);
}
/* Edit-profile "Interests" tag field (react-widgets Multiselect). The bright white
   line on dark is the vendor `.rw-widget-container { border: #ccc 1px solid }` â€” the
   Multiselect here gets no `.form-control` class (MultiselectInput puts className on
   its wrapper div, not the widget), so `.rw-widget` is `border: none` and the OUTER
   selectors below never paint it. Route the actual bordered inner container (and the
   `.form-control`/focus variants used by other legacy rw-widgets) to the dark border
   token. `:not(.BDS-component)` leaves BDS widgets alone; Upcoming-events keeps its
   own #react-upcoming-events-widget-root-scoped border, which still wins there. */
[data-theme="dark"] .rw-multiselect .rw-widget-container:not(.BDS-component):where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .form-control.rw-widget:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .rw-widget:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .rw-state-focus .rw-widget-picker:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  border-color: var(--theme-palette-light-borders) !important;
}

/* Edit-profile "@" handle prefix (E3): Bootstrap .input-group-addon default #eee/#ccc. */
[data-theme="dark"] .input-group-addon:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-soft-light);
  border-color: var(--theme-palette-light-borders);
  color: var(--theme-palette-dark);
}

/* Edit-profile banner upload area (E1): hardcoded @gray-lighter background. */
[data-theme="dark"] .profile-edit .profile-banner-upload:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-soft-light);
}

/* Profile Updates (P7): selected panel heading @beige background. */
[data-theme="dark"] .updates .panel-heading.selected:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-soft-light);
}

/* Profile My-tickets (P6): Bootstrap .style-editor-card surface + hardcoded #333 event title. */
[data-theme="dark"] .style-editor-card:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-light);
  border-color: var(--theme-palette-light-borders);
  color: var(--theme-palette-dark);
}
[data-theme="dark"] .event-title a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-dark);
}

/* Profile My-tickets venue rows (DIS-3804): the join link and the address/map link.
   Both carry `.general-link`, which generalstyles.css paints with the tenant's
   GENERAL_TEXT_LINK_COLOR literal and `!important`. That literal does not flip, so on
   any instance whose link color equals its dark card surface the link is invisible â€”
   on demo both are #2E203C, measured at 1.00:1 in a rendered browser, not inferred.

   Pre-existing (paid tickets always had an `audience_type` and so always rendered
   these rows); DIS-3804 widened it by giving RSVPs the same rows.

   Specificity, not just `!important`: generalstyles.css is linked AFTER theme.css, so an
   equal-specificity rule loses even when both are `!important`. Its selector is
   `body:not(#main-dashboard) .general-link`, which scores (1,1,1) â€” `:not(#main-dashboard)`
   contributes ID specificity â€” so a class-only selector loses no matter how many classes
   it stacks. Carrying the same `body:not(#main-dashboard)` prefix (the pattern the
   `.general-link--exclude` dark rule above already uses) takes this to (1,4,2) and wins.
   Verified by measuring the rendered ratio, not by reading the cascade.

   The token is the one the card's own copy already uses, set by the rule above, so the
   links match the surrounding text rather than introducing a third color. */
[data-theme="dark"] body:not(#main-dashboard) .style-editor-card .event-data-row a.general-link:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-dark) !important;
}

/* Privacy toggle (A1b): rmwc/Material switch unchecked track (@gray-lighter). The checked
   track/knob keep their brand color (intentionally unchanged). */
[data-theme="dark"] .mdc-switch:not(.mdc-switch--checked) .mdc-switch__track:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-dark-borders);
}

/* --- DIS-3651 / DIS-3653 legacy compiled-LESS tiles (member / chapter / event pages) ---
   These tiles are painted by compiled LESS with a hardcoded light hex â€” no operator setting,
   no palette token, no [data-theme="dark"] override â€” so in dark mode they render a white/beige
   block (people-card also with dark-on-dark text) ALWAYS, regardless of instance config. LESS
   can't flip, so re-point each hardcoded background to the role-swapping --theme-palette-* token.
   Each selector out-specifies its LESS source (via the [data-theme="dark"] prefix + the source's
   ancestor chain) so no !important is needed â€” which also means the operator card-color path
   (`.vertical-boxes .vertical-box-container` painted !important from GENERAL_CARD_* by DIS-3652)
   still wins when an instance sets a custom color; we only flip the uncustomized default.
   Borders are intentionally NOT re-pointed: both tiles are in the `.general-card` group, which
   generalstyles.css paints `border-width: 0 !important` (stroke re-added only via the operator
   GENERAL_CARD_STROKE_* !important path, DIS-3652), so a border-color override here is inert. */

/* People / member card (people_card.less:27,31): #ffffff bg + @people-card-text-color (#333)
   text â€” neither flips. (li is `.people-card general-card`.) */
[data-theme="dark"] .people-card:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-light);
  color: var(--theme-palette-dark);
}

/* Chapter tile (chapters.less:732 â†’ `.chapter .vertical-boxes .vertical-box-container`):
   @white bg. Text is `color:inherit`, so no color rule. */
[data-theme="dark"] .chapter .vertical-boxes .vertical-box-container:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-light);
}

/* Event `.startups` band (events.less:932 â†’ `#event_page .startups`): @beige (#f4f4f4) bg.
   Includes the #event_page id to out-specify the source (1,2,0 > 1,1,0). */
[data-theme="dark"] #event_page .startups:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-soft-light);
}

/* Startup logo tile (events.less:1029 â†’ `.image-container`): #fff backdrop behind
   each company `background-image` logo. Renders as a glaring white block in dark
   mode when a company has no logo; with a logo it's intended padding. Flip the
   backdrop to the light-role token so logo-less tiles read as a surface, not white.
   #event_page + .startups out-specify the source `.image-container` (1,2,0 > 0,1,0). */
[data-theme="dark"] #event_page .startups .image-container:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-light);
}

/* Legacy discussions comment editor (theme/src/js/discussions/PostForm + RichTextEditor).
   The source reads `var(--palette-white, #fff)` / `--palette-light` / `--palette-lightBorder`,
   none of which are defined anywhere in the repo or emitted by the installed BDS build, so
   every one resolves to its hardcoded light fallback in BOTH themes â€” a white slab on the
   dark topic page. Same defect DIS-3555 fixed for `next/` by aliasing the undefined names in
   variables.css; that route is NOT available here because SelfServeRichTextEditor/LinkModal
   uses `--palette-white` as white TEXT on a deliberately-dark bubble, which aliasing to a
   role-swapping surface token would turn dark-on-dark. Hence scoped overrides.

   Selectors prefix-match the CSS-Modules names (webpack `localIdentName:
   '[folder]-[name]-[local]-[hash:base64:5]'`) and deliberately exclude the content hash.
   `body:not(#main-dashboard)` is doing two jobs: the source rules are two classes (0,2,0) so
   a bare `[data-theme] [class*=â€¦]` would only tie and leave the winner to stylesheet order
   across a webpack-extracted bundle we don't control; and `[folder]` is only the immediate
   directory name, which `dashboardV2/components/common/RichTextEditor` also answers to â€” so
   the exclusion keeps a future name collision there out of reach, matching the convention
   the generalstyles.css rules already use.

   Each surface repoints its paired foreground: neither LESS file sets `color`, so text
   inherits --theme-palette-dark (white in dark) onto the white field. (DIS-3769) */
[data-theme="dark"] body:not(#main-dashboard) [class*="PostForm-styles-comment"]:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-light);
  border-color: var(--theme-palette-light-borders);
  box-shadow: 0 0 0 4px var(--theme-palette-soft-light);
  color: var(--theme-palette-dark);
}

/* `.editorContainer` is a TOP-LEVEL class in PostForm/styles.less, not nested under
   `.comment`, so this single rule covers the comment, reply AND edit variants. */
[data-theme="dark"] body:not(#main-dashboard) [class*="PostForm-styles-editorContainer"] div[role="textbox"]:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-light);
  color: var(--theme-palette-dark);
}

/* The submit-disabled scrim over the form. Its source fill is a hardcoded
   rgba(255,255,255,.5), which washed out the avatar and text beneath it on a white card and
   is a visible light film now that the card below it is dark â€” so mix the same 50% out of
   the surface token instead, and it dims in whichever theme is active.

   color-mix, NOT rgba(var(--â€¦RGB), .5): the --Color*RGB triplets in generalstyles.css are
   hardcoded literals that no [data-theme="dark"] block redefines, so that spelling would
   pin the scrim white in both themes â€” the exact defect being fixed. color-mix is the only
   way to get an alpha out of a token that actually flips. */
[data-theme="dark"] body:not(#main-dashboard) [class*="PostForm-styles-postFormMask"]:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: color-mix(in srgb, var(--theme-palette-light) 50%, transparent);
}

/* Resting border only. The `:not(â€¦-error)` guard is load-bearing: the source's error state
   is `.richTextFieldWrapper.error` (0,2,0) and paints the border red, but this selector
   out-specifies it â€” repainting the border neutral and silently removing the validation cue
   in dark mode. `--palette-error` is undefined too, but its #ff4d4f fallback reads fine on a
   dark surface, so the error state needs no dark treatment â€” only to be left alone. */
[data-theme="dark"] body:not(#main-dashboard) [class*="RichTextEditor-styles-richTextFieldWrapper"]:not([class*="RichTextEditor-styles-error"]):where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  border-color: var(--theme-palette-light-borders);
}

/* The pulsing skeleton shown while an image drop uploads (`.loading`) fills with the same
   undefined border token, i.e. a near-white flash on the dark editor. */
[data-theme="dark"] body:not(#main-dashboard) [class*="RichTextEditor-styles-loading"]:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-soft-light);
}

/* Login / signup secondary links (SGP-32161 #2): "Create account | Reset password" on
   the login card, and "Already have an account? Log in" under the signup form. These
   are the only interactive text on those cards that is not a button, and they are
   painted by the legacy link colour â€” a compile-time LESS value, so it keeps its light
   value while the card behind it flips, leaving the links barely readable.

   --theme-palette-primary is not usable here: it is re-declared by generalstyles.css
   after this sheet, so the dark brand slot never lands on legacy pages and the token
   resolves to the light brand value (on Etsy, the dark surface itself). The text token
   is the one that reliably flips. The underline is kept so the links still read as
   links without relying on colour alone. */
[data-theme="dark"] .login-alternatives a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .signup-submit-login a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-dark) !important;
  text-decoration: underline;
}

/* Password-reset confirmation support link (BVY-333) â€” same shape as the login/signup rule
   above. The anchor has no class, so it takes global.less's `a { color: #333333 }`, a
   compile-time literal whose (0,0,1) beats the panel's inherited (flipped) text colour:
   measured 1.20:1 on the dark panel, 15.13:1 with this rule. Light is untouched.

   No `!important`, unlike the siblings â€” generalstyles.css's link rules all need a
   `.general-body`/`.general-link` ancestor and this panel has none.

   Scoped by a body class because the anchor sits inside a blocktrans: a class on the <a>
   would change the msgid and drop all 47 catalogs to English. */
[data-theme="dark"] body.password-reset-done .panel-body a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: var(--theme-palette-dark);
  text-decoration: underline;
}

/* COOKIE CONSENT BANNER â€” dark mode (SGP-32216)
   ********************************************
   generalstyles.css paints this banner from HOMEPAGE_PRIVACY_POLICY_* and there was no
   dark treatment for it, so the text token flipped to near-black while the brand-token
   surface stayed put: purple-on-purple, 1.00:1, text and link both.

   DARK_PRIVACY_* comes from resolve_dark_privacy_context, which resolves the surface and
   its foregrounds as one group â€” so these three keys are already in step with each other
   and each just needs emitting. */
[data-theme="dark"] .cookie-consent-acknowledgement-conatiner:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  background-color: var(--theme-palette-primary) !important;
}

[data-theme="dark"] .cookie-consent-acknowledgement-conatiner .cookie-consent-text:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: #ffffff !important;
}

[data-theme="dark"] .cookie-consent-acknowledgement-conatiner .cookie-consent-text a:where(:not(.page-builder-content *, .rsvp-ticket-modal *)) {
  color: #ffffff !important;
}

.maps-geosuggest-field {
