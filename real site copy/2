[data-theme="dark"] .panel:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .panel-default:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .panel-heading:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .panel-footer:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .well:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
[data-theme="dark"] .card:where(:not(.page-builder-content *, .rsvp-ticket-modal *)),
/* generalstyles' `.style-editor-panel` hardcodes `background-color:#ffffff
   !important` (its optional GENERAL_PANEL_BACKGROUND_COLOR override is a light
