.bevy-embed-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    width: 100%;
    min-height: 120px;
    padding: 12px;
    border: 1px solid var(--ColorLightBorders);
    border-radius: 8px;
    background-color: var(--ColorSoftLight);
    color: var(--ColorSoftDark);
    text-align: center;
}

.bevy-embed-placeholder--compact {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 0;
